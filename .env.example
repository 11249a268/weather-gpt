# WeatherGPT Environment Configuration
# Step 1: All API keys are optional. Mock mode is active by default.

# REAL WEATHER API INTEGRATION POINT
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here
VITE_WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# AI MODEL INTEGRATION POINT
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_AI_MODEL_NAME=gemini-1.5-pro

# WEATHER ALERT API INTEGRATION POINT
VITE_IMD_ALERT_API_URL=https://api.imd.gov.in/alerts

# CLIMATE DATA INTEGRATION POINT
VITE_CLIMATE_DATA_API_KEY=your_climate_data_key

# VOICE API INTEGRATION POINT
VITE_VOICE_SPEECH_RECOGNITION_KEY=your_voice_api_key

# APP CONFIG
VITE_ENABLE_MOCK_MODE=true
VITE_APP_REGION=India
